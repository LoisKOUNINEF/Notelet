{
  "manifest_version": 3,
  "name": "Quicklet",
  "description": "Quicklet: notes and to-dos for each page and each site, in Chrome's side panel.",
  "version": "0.0.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icons/quicklet-16.png",
    "32": "assets/icons/quicklet-32.png",
    "48": "assets/icons/quicklet-48.png",
    "128": "assets/icons/quicklet-128.png"
  },
  "action": {
    "default_title": "Quicklet",
    "default_icon": {
      "16": "assets/icons/quicklet-16.png",
      "32": "assets/icons/quicklet-32.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "storage", "tabs"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Open Quicklet"
    }
  }
}
