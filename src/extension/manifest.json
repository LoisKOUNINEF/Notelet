{
  "manifest_version": 3,
  "name": "Notelet",
  "description": "Notelet: Notes & tasks, at a glance.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icons/notelet-16.png",
    "32": "assets/icons/notelet-32.png",
    "48": "assets/icons/notelet-48.png",
    "128": "assets/icons/notelet-128.png"
  },
  "action": {
    "default_title": "Notelet",
    "default_icon": {
      "16": "assets/icons/notelet-16.png",
      "32": "assets/icons/notelet-32.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "storage", "tabs"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Open Notelet"
    }
  }
}
