{
  "name": "notelet",
  "version": "1.0.0",
  "type": "module",
  "imports": {
    "#root/*.js": "./*.js"
  },
  "scripts": {
    "build": "node tools/builder/builder.js",
    "build:prod": "node tools/builder/builder.js --prod",
    "typecheck": "node tools/builder/builder.js --typecheck",
    "package:extension": "node tools/builder/builder.js --prod && node tools/extension/package-extension.js",
    "package:extension:chrome": "node tools/builder/builder.js --prod && node tools/extension/package-extension.js --browser chrome",
    "package:extension:firefox": "node tools/builder/builder.js --prod && node tools/extension/package-extension.js --browser firefox",
    "validate:extension": "node tools/extension/validate-extension.js",
    "lint:extension": "web-ext lint --source-dir dist/firefox",
    "generate": "node tools/generator/generator.js",
    "testin-nutin": "npm run build && node tools/testin-nutin/runner.js",
    "testin-nutin:only": "node tools/testin-nutin/runner.js",
    "testin-nutin:watch": "npm run build && node tools/testin-nutin/watch-tests.js",
    "testin-nutin:coverage": "npm run build && node tools/testin-nutin/runner.js --coverage",
    "testin-nutin:verbose": "npm run build && node tools/testin-nutin/runner.js --verbose"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "chokidar": "^5.0.0",
    "esbuild": "^0.28.2",
    "html-minifier-terser": "^7.2.0",
    "jsdom": "^30.1.1",
    "linkedom": "^0.18.14",
    "sass": "^1.106.1",
    "typescript": "^7.0.2",
    "web-ext": "10.8.0"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "a11y-elements": "^0.6.0"
  }
}
